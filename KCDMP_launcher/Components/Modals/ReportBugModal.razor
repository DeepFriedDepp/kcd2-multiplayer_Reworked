@inherits ModalBase
@using KCDMP_launcher.Components.Shared

@if (IsVisible)
{
    <div class="modal-overlay @(isClosing ? "closing" : "")">
        <div class="modal-box" @onclick:stopPropagation="true">

            <div class="modal-frame-top modal-frame-bg"></div>

            <div class="modal-content" style="text-align: center;">
                <div class="modal-title">REPORT A BUG</div>

                <p>
                    Found something broken? Tell us on GitHub, or drop a message
                    in Discord -- whichever you'd rather use.
                </p>
                <p>
                    Please attach the log bundle: COLLECT LOGS puts a zip on
                    your Desktop with everything we need (game log, agent log,
                    launcher log).
                </p>

                <div class="modal-actions">
                    <button class="kcd-btn primary" @onclick="OpenGitHubIssues">GITHUB ISSUES</button>
                    <button class="kcd-btn primary" @onclick="OpenDiscord">DISCORD</button>
                    <button class="kcd-btn primary" @onclick="CollectLogs">COLLECT LOGS</button>
                </div>
                @if (!string.IsNullOrEmpty(collectResult))
                {
                    <p style="margin-top: 10px;">@collectResult</p>
                }
                <div class="modal-actions" style="margin-top: 10px;">
                    <button class="kcd-btn" @onclick="CloseModalAsync">CLOSE</button>
                </div>
            </div>

            <div class="modal-frame-bottom modal-frame-bg"></div>
        </div>
    </div>
}

@code {
    // Hardcoded rather than a setting: these are the project's own repo and
    // community, not something a server operator or player should point
    // elsewhere -- unlike MasterServerUrl or RelayPath, there is only ever
    // one right value.
    private const string GitHubIssuesUrl = "https://github.com/DeepFriedDepp/kcd2-multiplayer_Reworked/issues";
    private const string DiscordInviteUrl = "https://discord.gg/m4U95xUZ5";

    // WO-39, item K: supplied by Home, which owns the settings these paths
    // come from. Empty is fine -- LogBundle skips what it cannot find.
    [Parameter] public string GameRoot { get; set; } = "";
    [Parameter] public string AgentDirectory { get; set; } = "";

    private string collectResult = "";

    private void OpenGitHubIssues() => UrlLauncher.Open(GitHubIssuesUrl);
    private void OpenDiscord() => UrlLauncher.Open(DiscordInviteUrl);

    private void CollectLogs()
    {
        try
        {
            string zip = LogBundle.Collect(GameRoot, AgentDirectory);
            collectResult = $"Saved to your Desktop: {System.IO.Path.GetFileName(zip)}";
        }
        catch (Exception ex)
        {
            collectResult = $"Could not collect logs: {ex.Message}";
        }
    }
}
