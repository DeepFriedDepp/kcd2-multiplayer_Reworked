@inherits KCDMP_launcher.Components.ModalBase
@using System.IO
@using KCDMP_launcher.Models
@using KCDMP_launcher.Services
@implements IDisposable

@if (IsVisible && snapshot?.Invite is not null)
{
    <div class="modal-overlay @(isClosing ? "closing" : "")">
        <div class="modal-box" @onclick:stopPropagation="true">
            <div class="modal-frame-top modal-frame-bg"></div>
            <div class="modal-content">
                <div class="modal-title">DICE</div>
                <p>@snapshot.Invite.FromName challenges you to a game of Farkle.</p>
                <div class="modal-actions">
                    <button class="kcd-btn primary" @onclick="() => RespondAsync(true)">ACCEPT</button>
                    <button class="kcd-btn" @onclick="() => RespondAsync(false)">DECLINE</button>
                </div>
            </div>
            <div class="modal-frame-bottom modal-frame-bg"></div>
        </div>
    </div>
}
else if (IsVisible && snapshot?.Session is not null)
{
    var session = snapshot.Session;
    var myScore = session.Role == "Initiator" ? session.ScoreInitiator : session.ScoreAcceptor;
    var peerScore = session.Role == "Initiator" ? session.ScoreAcceptor : session.ScoreInitiator;

    <div class="modal-overlay @(isClosing ? "closing" : "")">
        <div class="modal-box dice-box" @onclick:stopPropagation="true">
            <div class="modal-frame-top modal-frame-bg"></div>
            <div class="modal-content">
                <div class="modal-title">DICE — FARKLE</div>

                @if (session.Result is not null)
                {
                    <div class="dice-banner @(session.Result.DidIWin(session.Role) ? "dice-win" : "dice-lose")">
                        @(session.Result.DidIWin(session.Role) ? "YOU WIN" : "YOU LOSE")
                        — @session.Result.ScoreInitiator vs @session.Result.ScoreAcceptor
                    </div>
                    <div class="modal-actions">
                        <button class="kcd-btn" @onclick="Dismiss">CLOSE</button>
                    </div>
                }
                else
                {
                    <div class="dice-banner @(session.IsMyTurn ? "dice-your-turn" : "")">
                        @(session.IsMyTurn ? "YOUR TURN" : $"{session.PeerName}'s TURN")
                    </div>

                    <div class="dice-scores">
                        <span>You: @myScore (target @session.TargetScore)</span>
                        <span>Turn total: @session.TurnTotal</span>
                        <span>@session.PeerName: @peerScore</span>
                    </div>

                    <div class="dice-row">
                        @for (int i = 0; i < session.KeptFaces.Length; i++)
                        {
                            <div class="die kept">@session.KeptFaces[i]</div>
                        }
                        @for (int i = 0; i < session.FreeFaces.Length; i++)
                        {
                            int idx = i; // capture for the closure
                            bool selected = pendingKeepIndices.Contains(idx);
                            bool clickable = session.IsMyTurn && session.Phase == "AwaitingKeep";
                            <div class="die free @(selected ? "selected" : "") @(clickable ? "clickable" : "")"
                                 @onclick="() => ToggleFree(idx, clickable)">
                                @session.FreeFaces[i]
                            </div>
                        }
                    </div>

                    @if (session.LastError is not null)
                    {
                        <p class="dice-error">@FriendlyError(session.LastError)</p>
                    }

                    <div class="modal-actions">
                        @if (session.IsMyTurn && session.Phase == "AwaitingKeep")
                        {
                            <button class="kcd-btn primary" disabled="@(pendingKeepIndices.Count == 0)" @onclick="SubmitKeep">KEEP</button>
                        }
                        @if (session.IsMyTurn && session.Phase == "AwaitingRoll")
                        {
                            <button class="kcd-btn primary" @onclick="Roll">ROLL</button>
                            <button class="kcd-btn" disabled="@(session.TurnTotal <= 0)" @onclick="Bank">BANK</button>
                        }
                        <button class="kcd-btn" @onclick="Forfeit">FORFEIT</button>
                    </div>
                }
            </div>
            <div class="modal-frame-bottom modal-frame-bg"></div>
        </div>
    </div>
}

@code {
    [Inject] public required DiceIpcClient DiceIpc { get; set; }

    private DiceIpcSnapshot? snapshot;
    private HashSet<int> pendingKeepIndices = new();

    protected override void OnInitialized()
    {
        LoadPortFromSettings();
        DiceIpc.SnapshotChanged += OnSnapshotChanged;
    }

    private void LoadPortFromSettings()
    {
        // Deliberately independent of Home.razor.cs's own settings load: this
        // component is meant to work standalone (see DiceIpcServer's doc
        // comment on why the channel cannot assume the launcher started the
        // agent), so it reads the same settings.json rather than depending on
        // Home's already-large state.
        try
        {
            const string settingsFileName = "settings.json";
            if (File.Exists(settingsFileName))
            {
                var settings = System.Text.Json.JsonSerializer.Deserialize<AppSettings>(File.ReadAllText(settingsFileName));
                if (settings is not null) DiceIpc.SetPort(settings.DiceIpcPort);
            }
        }
        catch { /* defaults to DiceIpcClient's own port */ }
    }

    private void OnSnapshotChanged(DiceIpcSnapshot? s)
    {
        InvokeAsync(() =>
        {
            snapshot = s;
            bool sessionChanged = snapshot?.Session?.SessionId != null &&
                                  pendingKeepIndices.Count > 0 &&
                                  snapshot.Session.Phase != "AwaitingKeep";
            if (sessionChanged) pendingKeepIndices.Clear();

            IsVisible = snapshot?.Invite is not null || snapshot?.Session is not null;
            StateHasChanged();
        });
    }

    private async Task RespondAsync(bool accept)
    {
        pendingKeepIndices.Clear();
        await DiceIpc.RespondAsync(accept);
    }

    private void ToggleFree(int index, bool clickable)
    {
        if (!clickable) return;
        if (!pendingKeepIndices.Remove(index)) pendingKeepIndices.Add(index);
    }

    private async Task SubmitKeep()
    {
        byte mask = 0;
        foreach (var i in pendingKeepIndices) mask |= (byte)(1 << i);
        pendingKeepIndices.Clear();
        await DiceIpc.KeepAsync(mask);
    }

    private Task Roll() => DiceIpc.RollAsync();
    private Task Bank() => DiceIpc.BankAsync();
    private Task Forfeit() => DiceIpc.ForfeitAsync();

    private void Dismiss()
    {
        // The relay already ended the session; this just stops showing the
        // result screen. A fresh Invite or SessionStarted overwrites it either way.
        snapshot = null;
        IsVisible = false;
        StateHasChanged();
    }

    private static string FriendlyError(string reason) => reason switch
    {
        "NotYourTurn" => "It's not your turn.",
        "WrongPhase" => "You can't do that right now.",
        "EmptyKeep" => "Select at least one die to keep.",
        "KeepIndexOutOfRange" => "Invalid selection.",
        "InvalidKeepSelection" => "That selection doesn't score.",
        "NothingToBank" => "Nothing to bank yet.",
        "GameAlreadyOver" => "The match already ended.",
        _ => reason,
    };

    public void Dispose()
    {
        DiceIpc.SnapshotChanged -= OnSnapshotChanged;
    }
}
