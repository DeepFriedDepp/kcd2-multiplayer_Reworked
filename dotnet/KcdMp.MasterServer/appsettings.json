{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "Using": [ "Serilog.Sinks.Console" ],
    "WriteTo": [
      { "Name": "Console" }
    ]
  },

  "Registry": {
    "MaxServers": 500
  },

  // Proxy support: only turn this on when something in front of this process is setting
  // X-Forwarded-For, or a caller can list a server under any address it likes.
  // A proxy on the same host needs nothing else; one elsewhere has to be named
  // in KnownProxies, e.g. ["10.0.0.2"].
  "ForwardedHeaders": {
    "Enabled": false,
    "KnownProxies": []
  },

  // Binds every interface: a master server nobody outside the machine can
  // reach is not one. Put TLS in front of it (a reverse proxy) before pointing
  // real players at it -- relays connect over ws:// or wss:// to whatever this
  // ends up being published as.
  "Urls": "http://0.0.0.0:5100"
}
