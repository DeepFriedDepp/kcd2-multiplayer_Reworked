<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>KcdMpClient</AssemblyName>
  </PropertyGroup>

  <!--
    WO-19: stamp this build with the repo's own VERSION file so
    ReleaseVersionInfo.Current reflects reality instead of a second,
    independently-maintained constant. Reads only, never writes VERSION.
    See docs/VERSIONING.md: the file's content is the user's call, always.
  -->
  <PropertyGroup>
    <VersionFileContent Condition="Exists('$(MSBuildThisFileDirectory)..\..\VERSION')">$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)..\..\VERSION').Trim())</VersionFileContent>
    <Version Condition="'$(VersionFileContent)' != ''">$(VersionFileContent)</Version>
    <!-- Otherwise the SDK appends "+<git-commit-hash>" to InformationalVersion,
         which both looks wrong in the UI and breaks ReleaseVersionCompare's
         Major.Minor.Patch parsing outright. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DiscordRichPresence" Version="1.6.1.70" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <!-- WO-110 R10: pinned to the version the relay's and master server's
         publishes carry (Serilog.Extensions.Hosting 10 -> Microsoft.Extensions.*
         10 -> System.Text.Json 10). tools/Publish-Release.ps1 flat-merges the
         four publishes, so the relay's System.Text.Json 10 overwrote this
         project's inbox 8.0 copy while KcdMpClient.deps.json still listed 8.0
         and no System.IO.Pipelines at all: the shipped agent's loader could
         not see the System.IO.Pipelines 10 that STJ 10 needs, and every JSON
         write failed (observed by tools/Test-PayloadSmoke.ps1, 2026-09-22).
         Referencing the same package here puts both assemblies, at the same
         versions, into this exe's own dependency graph. -->
    <PackageReference Include="System.Text.Json" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\KcdMp.Protocol\KcdMp.Protocol.csproj" />
  </ItemGroup>

  <!-- WO-96: the generated main-quest objective registry (tools/Build-MainQuestObjectives.ps1). -->
  <ItemGroup>
    <EmbeddedResource Include="mainquest-objectives.json" LogicalName="KcdMp.Client.mainquest-objectives.json" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="KcdMp.Wire" />
  </ItemGroup>

</Project>
